# Read-only connection to shrub's MySQL. Create the user with
# scripts/create_ro_user.sql — milton must never hold write credentials.
MILTON_DB_HOST=127.0.0.1
MILTON_DB_PORT=3384
MILTON_DB_USER=milton_ro
MILTON_DB_PASSWORD=
MILTON_DB_NAME=stonks2

# Tenant whose settings receive approved weights (Q3: tenant_settings).
MILTON_TENANT_ID=4

# Approval loop. Milton borrows shrub's mailbox and tags the subject with a
# token so shrub's inbound router hands the reply back instead of feeding it
# to the CEO agent.
MILTON_APPROVER=jonisbishop@gmail.com
MILTON_SUBJECT_TAG=milton

# Milton sends no mail itself — shrub does it, and forwards replies back.
# Must match shrub's own INTERNAL_API_TOKEN.
MILTON_SHRUB_URL=http://app:8000
INTERNAL_API_TOKEN=

# Milton's own state (proposals + decisions). shrub's database is read-only
# to milton by design, so this is the only thing it writes.
MILTON_STATE_DB=/app/data/milton.sqlite3
